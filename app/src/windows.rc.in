#include <windows.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@MAGNITE_UPDATE_SEQUENCE@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@MAGNITE_UPDATE_SEQUENCE@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Magnite contributors\0"
   VALUE "FileDescription", "Magnite LLM\0"
   VALUE "FileVersion", "@MAGNITE_VERSION@\0"
   VALUE "ProductName", "Magnite LLM\0"
   VALUE "ProductVersion", "@MAGNITE_VERSION@\0"
   VALUE "OriginalFilename", "magnite-app.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
