/* Magnite · release UI. Colors resolve from the shared Theme tokens. */
QWidget { font-family: @bodyFont; font-size: 13px; color: @textPrimary; }
QMainWindow { background: @canvasBackground; }
QDialog { background: @canvasBackground; }
QLabel { background: transparent; border: none; }
QWidget#sidebar { background: @insetBackground; border: none; border-right: 1px solid @surfaceBorder; }
QFrame#connectionStatus { background: transparent; border: none; }
QLabel#statusPill { padding: 0; background: transparent; color: @textSecondary; font-size: 12px; }
QLabel#connectionDot { background: @textMuted; border-radius: 3px; }
QLabel#connectionDot[state="ok"] { background: @statusSuccess; }
QLabel#connectionDot[state="err"] { background: @statusError; }
QFrame#headerDivider { background: @surfaceBorder; border: none; }
QPushButton#themeToggle { background: transparent; border: 1px solid transparent; border-radius: 6px; color: @textSecondary; padding: 3px 8px; }
QPushButton#themeToggle:hover { background: @surfaceFillHover; color: @textPrimary; }
QPushButton#themeToggle:focus { color: @textPrimary; }
QLabel#statusPill[state="err"] { color: @statusError; }
QLabel#logoLabel { font-family: @headingFont; font-weight: 600; color: @textPrimary; font-size: 25px; padding: 2px 0; }
QLabel#studioTag { font-size: 10px; font-weight: 600; letter-spacing: 1px; font-family: @bodyFont; color: @textMuted; }
QLabel#heroKicker { font-size: 12px; font-weight: 600; letter-spacing: 1px; }
QPushButton { background: @surfaceFill; border: 1px solid @surfaceBorder; border-radius: 8px; padding: 7px 12px; min-height: 20px; font-weight: 500; }
QPushButton:hover { background: @surfaceFillHover; border-color: @surfaceBorder; }
QPushButton:pressed { background: @surfaceFillActive; }
QPushButton:focus { border: 1px solid @surfaceBorder; }
QPushButton:disabled { color: @textMuted; background: @insetBackground; border-color: @surfaceBorder; }
QPushButton#navBtn { padding: 8px 10px; border: 1px solid transparent; background: transparent; text-align: left; border-radius: 8px; color: @textSecondary; }
QPushButton#navBtn:hover { background: @surfaceFillHover; }
QPushButton#navBtn:checked { background: @insetBackground; color: @accentLabel; }
QPushButton#navBtn:pressed { background: @surfaceFillActive; }
QWidget#sidebar[collapsed="true"] QPushButton#navBtn { padding: 0; text-align: center; }
QPushButton#sidebarToggle { padding: 0; border: 1px solid @surfaceBorder; border-radius: 8px; background: @surfaceFill; }
QPushButton#sidebarToggle:hover { background: @surfaceFillHover; }
QPushButton#sidebarToggle:pressed, QPushButton#sidebarNewChat:pressed { background: @surfaceFillActive; }
QPushButton#sidebarNewChat { padding: 0; border: 1px solid @surfaceBorder; border-radius: 13px; background: @surfaceFill; }
QPushButton#sidebarNewChat:hover { background: @surfaceFillHover; }
QPushButton#sidebarNewChat:disabled { background: transparent; }
QPushButton#primaryBtn { background: @accentPrimary; color: @accentText; border-color: @accentPrimary; }
QPushButton#cardPrimary { background: @accentPrimary; color: @accentText; border-color: @accentPrimary; }
QPushButton#primaryBtn:hover { background: @accentHover; border-color: @accentHover; }
QPushButton#cardPrimary:hover { background: @accentHover; border-color: @accentHover; }
QPushButton#primaryBtn:pressed { background: @accentActive; }
QPushButton#cardPrimary:pressed { background: @accentActive; }
QPushButton#primaryBtn:disabled { background: @insetBackground; color: @textMuted; border-color: @surfaceBorder; }
QPushButton#cardPrimary:disabled { background: @insetBackground; color: @textMuted; border-color: @surfaceBorder; }
QPushButton#destructiveBtn, QPushButton#cancelDownload { color: @statusError; }
QPushButton#cardDanger { color: @statusError; }
QPushButton#destructiveBtn:hover, QPushButton#cancelDownload:hover { background: @dangerHover; }
QPushButton#cardDanger:hover { background: @dangerHover; }
QLabel#panelTitle { font-family: @headingFont; font-size: 24px; font-weight: 600; }
QLabel#panelSubtitle { color: @textSecondary; font-size: 12px; }
QLabel#subtitle { color: @textSecondary; font-size: 12px; }
QLabel#statusLabel { color: @textSecondary; font-size: 12px; }
QLabel#cardMeta { color: @textSecondary; font-size: 12px; }
QLabel#contextDivider { color: @textMuted; font-size: 12px; padding: 6px 0; }
QLabel#cardDownloaded { color: @statusSuccess; font-size: 12px; font-weight: 600; }
QLabel#headingLabel { font-family: @headingFont; font-size: 14px; font-weight: 600; }
QLabel#cardTitle { font-family: @headingFont; font-size: 14px; font-weight: 600; }
QLabel#metricValue { font-family: @headingFont; font-size: 20px; color: @textPrimary; }
QLabel#monoLabel { font-family: @monoFont; font-size: 12px; }
QFrame#surfaceCard { background: @surfaceFill; border: 1px solid @surfaceBorder; border-radius: 10px; }
QWidget#surfaceCard { background: @surfaceFill; border: 1px solid @surfaceBorder; border-radius: 10px; }
QFrame#modelCard { background: @surfaceFill; border: 1px solid @surfaceBorder; border-radius: 10px; }
QFrame#adapterCard { background: @surfaceFill; border: 1px solid @surfaceBorder; border-radius: 10px; border-left: 3px solid @surfaceBorder; }
QFrame#ragDocCard { background: @surfaceFill; border: 1px solid @surfaceBorder; border-radius: 10px; }
QFrame#ragConfigCard { background: @surfaceFill; border: 1px solid @surfaceBorder; border-radius: 10px; }
QFrame#modelCard:hover { border-color: @surfaceBorder; }
QFrame#adapterCard:hover { border-color: @surfaceBorder; }
QFrame#modelCard[selected="true"] { border: 1px solid @surfaceBorder; background: @surfaceFillHover; }
QFrame#adapterCard[active="true"] { border: 1px solid @surfaceBorder; border-left: 3px solid @surfaceBorder; background: @surfaceFillHover; }
QLabel#archBadge { background: @insetBackground; color: @textSecondary; padding: 4px 8px; border-radius: 6px; font-size: 12px; }
QLabel#adapterPill { background: @insetBackground; color: @textSecondary; padding: 4px 8px; border-radius: 6px; font-size: 12px; }
QLabel#chatPill { background: @insetBackground; color: @textSecondary; padding: 4px 8px; border-radius: 6px; font-size: 12px; }
QLineEdit { background: @surfaceFill; color: @textPrimary; border: 1px solid @surfaceBorder; border-radius: 8px; padding: 7px; selection-background-color: @accentPrimary; selection-color: @accentText; }
QComboBox { background: @surfaceFill; color: @textPrimary; border: 1px solid @surfaceBorder; border-radius: 8px; padding: 8px 36px 8px 10px; selection-background-color: @accentPrimary; selection-color: @accentText; combobox-popup: 0; }
QComboBox:hover { background: @surfaceFillHover; border-color: @surfaceBorder; }
QComboBox:on { border-color: @surfaceBorder; }
QComboBox QLineEdit { background: transparent; border: none; border-radius: 0; padding: 0; }
QSpinBox { background: @surfaceFill; color: @textPrimary; border: 1px solid @surfaceBorder; border-radius: 8px; padding: 7px; selection-background-color: @accentPrimary; selection-color: @accentText; padding-right: 20px; }
QDoubleSpinBox { background: @surfaceFill; color: @textPrimary; border: 1px solid @surfaceBorder; border-radius: 8px; padding: 7px; selection-background-color: @accentPrimary; selection-color: @accentText; padding-right: 20px; }
QTextEdit { background: @surfaceFill; color: @textPrimary; border: 1px solid @surfaceBorder; border-radius: 8px; padding: 7px; selection-background-color: @accentPrimary; selection-color: @accentText; }
QPlainTextEdit { background: @surfaceFill; color: @textPrimary; border: 1px solid @surfaceBorder; border-radius: 8px; padding: 7px; selection-background-color: @accentPrimary; selection-color: @accentText; }
QLineEdit:focus { border-color: @surfaceBorder; }
QComboBox:focus { border-color: @surfaceBorder; }
QSpinBox:focus { border-color: @surfaceBorder; }
QDoubleSpinBox:focus { border-color: @surfaceBorder; }
QTextEdit:focus { border-color: @surfaceBorder; }
QPlainTextEdit:focus { border-color: @surfaceBorder; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled,
QTextEdit:disabled, QPlainTextEdit:disabled { background: @insetBackground; color: @textMuted; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; border: none; width: 30px; background: transparent; }
QComboBox::down-arrow { image: none; }
QComboBox QAbstractItemView { background: @surfaceFill; color: @textPrimary; border: 1px solid @surfaceBorder; border-radius: 8px; padding: 4px; outline: 0; selection-background-color: @accentPrimary; selection-color: @accentText; }
QComboBox QAbstractItemView::item { min-height: 24px; padding: 6px 10px; border-radius: 4px; }
QComboBox QAbstractItemView::item:hover { background: @surfaceFillHover; }
QComboBox QAbstractItemView::item:selected { background: @surfaceFillHover; color: @textPrimary; }
QComboBox QAbstractItemView::item:disabled { color: @textMuted; }
QGroupBox { background: @surfaceFill; border: 1px solid @surfaceBorder; border-radius: 10px; margin-top: 12px; padding: 9px; }
QGroupBox::title { subcontrol-origin: margin; left: 16px; padding: 0 6px; font-weight: 600; }
QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; border: none; }
QStackedWidget { background: transparent; border: none; }
QScrollBar:vertical { background: transparent; width: 3px; margin: 0; }
QScrollBar::handle:vertical { background: @accentPrimary; min-height: 30px; border-radius: 3px; }
QScrollBar::handle:vertical:hover { background: @accentHover; }
QScrollBar::add-line:vertical { height: 0; }
QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical { background: transparent; }
QScrollBar::sub-page:vertical { background: transparent; }
QProgressBar { background: @insetBackground; border: none; text-align: center; min-height: 8px; border-radius: 4px; }
QProgressBar::chunk { background: @accentPrimary; border-radius: 4px; }
QFrame#chatBubbleUser { background: @surfaceFillHover; border: 1px solid @surfaceBorder; border-radius: 14px; }
QFrame#chatBubbleAssistant { border-radius: 6px; background: transparent; border: none; }
QLabel#chatBubbleText { color: @textPrimary; font-size: 14px; }
QWidget#versionSwitcher QPushButton, QPushButton#editButton, QPushButton#retryButton { background: transparent; border: none; border-radius: 6px; padding: 0; min-height: 0; }
QWidget#versionSwitcher QPushButton:hover:enabled, QPushButton#editButton:hover:enabled, QPushButton#retryButton:hover:enabled { background: @surfaceFillHover; }
QPlainTextEdit#messageEditBox { background: @insetBackground; border: 1px solid @surfaceBorder; border-radius: 10px; padding: 8px; font-size: 14px; }
QPushButton#editSave { background: @accentPrimary; color: @accentText; border-color: @accentPrimary; }
QPushButton#editSave:hover { background: @accentHover; border-color: @accentHover; }
QLabel#versionLabel { color: @textMuted; font-size: 12px; }
QStatusBar { background: @insetBackground; color: @textSecondary; font-size: 12px; border-top: 1px solid @surfaceBorder; }
QToolTip { background: @textPrimary; color: @surfaceFill; padding: 6px 8px; border: none; border-radius: 6px; }
QFrame#workspaceBar { border-bottom: 1px solid @surfaceBorder; background: @canvasBackground; }
QLabel#tileKicker { font-family: @bodyFont; font-size: 10px; color: @textSecondary; }
QLabel#tileValue { font-family: @headingFont; font-size: 15px; color: @textPrimary; }
QLabel#tileCaption { color: @textSecondary; font-size: 12px; }
QSplitter::handle { background: transparent; border-radius: 2px; }
QSplitter::handle:hover { background: @surfaceBorderHover; }
QLabel#rackEmpty { font-family: @bodyFont; color: @textSecondary; border: 1px solid @surfaceBorder; padding: 30px; font-size: 12px; background: @surfaceFill; border-radius: 6px; }
QTabWidget::pane { background: transparent; border: none; top: 8px; }
QTabBar::tab { color: @textSecondary; border: none; padding: 6px 14px; min-width: 48px; }
QTabBar::tab:selected { color: @textPrimary; }
QTabBar::tab:disabled { color: @textMuted; }
QPlainTextEdit#logView { font-family: @monoFont; background: @canvasBackground; }
QFrame#studioNote { background: @surfaceFill; border: 1px solid @surfaceBorder; border-left: 3px solid @accentPrimary; border-radius: 10px; }
QLabel#noteTitle { font-family: @headingFont; font-size: 14px; font-weight: 500; }
QPushButton#overviewTile { background: @surfaceFill; border: 1px solid @surfaceBorder; border-radius: 10px; padding: 0; text-align: left; min-height: 84px; }
QPushButton#overviewTile:hover { background: @surfaceFillHover; border-color: @surfaceBorder; }
QPushButton#overviewTile[tone="error"] { border-top-color: @surfaceBorder; border-color: @surfaceBorder; }
QLabel#emptyConversation { font-family: @headingFont; font-size: 30px; font-weight: 500; color: @textPrimary; padding: 0; }
QPushButton#overviewTile:focus { border-color: @accentLabel; }
QPushButton#overviewTile:pressed { background: @surfaceFillActive; }
QLabel#statusLabel[state="error"] { color: @statusError; }
QLabel#statusLabel[state="ok"] { color: @statusSuccess; }
QTabBar::tab:focus { color: @accentPrimary; }
QSpinBox::up-button { width: 20px; background: transparent; border: none; border-left: 1px solid @surfaceBorder; border-top-right-radius: 7px; }
QSpinBox::up-button:hover { background: @surfaceFillHover; }
QSpinBox::up-button:disabled { background: @insetBackground; }
QSpinBox::down-button { width: 20px; background: transparent; border: none; border-left: 1px solid @surfaceBorder; border-bottom-right-radius: 7px; }
QSpinBox::down-button:hover { background: @surfaceFillHover; }
QSpinBox::down-button:disabled { background: @insetBackground; }
QDoubleSpinBox::up-button { width: 20px; background: transparent; border: none; border-left: 1px solid @surfaceBorder; border-top-right-radius: 7px; }
QDoubleSpinBox::up-button:hover { background: @surfaceFillHover; }
QDoubleSpinBox::up-button:disabled { background: @insetBackground; }
QDoubleSpinBox::down-button { width: 20px; background: transparent; border: none; border-left: 1px solid @surfaceBorder; border-bottom-right-radius: 7px; }
QDoubleSpinBox::down-button:hover { background: @surfaceFillHover; }
QDoubleSpinBox::down-button:disabled { background: @insetBackground; }
QSpinBox:disabled { background: @insetBackground; color: @textMuted; }
QDoubleSpinBox:disabled { background: @insetBackground; color: @textMuted; }
QTextEdit:disabled { background: @insetBackground; color: @textMuted; }
QPlainTextEdit:disabled { background: @insetBackground; color: @textMuted; }
QScrollBar:horizontal { background: transparent; height: 3px; margin: 0; }
QScrollBar::handle:horizontal { background: @accentPrimary; min-width: 30px; border-radius: 3px; }
QScrollBar::add-line:horizontal { width: 0; }
QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal { background: transparent; }
QScrollBar::sub-page:horizontal { background: transparent; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: none; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: none; }
QFrame#chatSettings { background: @surfaceFill; border: 1px solid @surfaceBorder; border-radius: 8px; }
QFrame#chatComposer { background: @surfaceFill; border: 1px solid @surfaceBorder; border-radius: 16px; }
QPlainTextEdit#chatInput { background: transparent; border: none; padding: 4px; font-size: 14px; }
QPlainTextEdit#chatInput:focus { border: none; }
QLabel#chatEyebrow { color: @accentLabel; font-size: 10px; letter-spacing: 2px; }
QPushButton#promptSuggestion { background: @surfaceFill; border: 1px solid @surfaceBorder; color: @textSecondary; text-align: left; padding: 12px; border-radius: 12px; }
QPushButton#promptSuggestion:hover { color: @textPrimary; border-color: @surfaceBorder; background: @surfaceFillHover; }
QPushButton#promptSuggestion:focus { border-color: @surfaceBorder; }
QPushButton#destructiveBtn:disabled, QPushButton#cancelDownload:disabled, QPushButton#cardDanger:disabled { color: @textMuted; background: @insetBackground; }
QFrame#chatComposer[focused="true"] { border-color: @surfaceBorder; }
QFrame#ragDocCard:hover { border-color: @surfaceBorder; }
QFrame#ragDocCard[selected="true"] { border-color: @surfaceBorder; background: @surfaceFillHover; }
QFrame#ragDocCard:focus, QFrame#modelCard:focus { border: 1px solid @surfaceBorder; }
QPushButton#primaryBtn:disabled, QPushButton#cardPrimary:disabled { background: @insetBackground; color: @textMuted; border-color: @surfaceBorder; }
QLabel#statusLabel[state="warn"] { color: @statusWarning; }
QLabel#activeBadge { color: @statusSuccess; font-weight: 600; }
QComboBox::drop-down:disabled { background: transparent; }
QLabel#sectionHint { color: @textSecondary; font-size: 12px; }

/* Training run summaries keep the same compact hierarchy as the setup cards. */
QWidget#trainingRunRow { background: transparent; }
QListWidget#trainingRuns { border: none; background: transparent; }
QListWidget#trainingRuns::item { border-bottom: 1px solid @surfaceBorder; }
QListWidget#trainingRuns::item:hover, QListWidget#trainingRuns::item:selected { background: @surfaceFillHover; }
QLabel#runState[state="ok"] { color: @statusSuccess; }
QLabel#runState[state="error"] { color: @statusError; }
QLabel#runState[state="warn"] { color: @statusWarning; }
QTableWidget#trainingComparison { background: @surfaceFill; color: @textPrimary; border: 1px solid @surfaceBorder; gridline-color: @surfaceBorder; }
QTableWidget#trainingComparison::item { padding: 6px; }
QTableWidget#trainingComparison::item:selected { background: @surfaceFillHover; color: @textPrimary; }
QTableWidget#trainingComparison QHeaderView::section { background: @insetBackground; color: @textSecondary; border: none; padding: 8px; }

/* Training iteration 02: a recipe above three aligned instrument lanes. */
QFrame#trainingRecipe { background: @surfaceFill; border: 1px solid @surfaceBorder; border-radius: 12px; }
QFrame#recipeNode { background: transparent; border: none; border-left: 1px solid @surfaceBorder; border-radius: 0; }
QFrame#recipeNode QLabel#headingLabel { color: @textMuted; font-size: 10px; letter-spacing: 1px; }
QFrame#trainingBudget { background: @insetBackground; border: none; border-left: 3px solid @accentLabel; border-radius: 0; }
QFrame#trainingBudget QLabel#headingLabel { color: @textSecondary; font-size: 10px; letter-spacing: 1px; }
QFrame#trainingSignalBoard { background: @surfaceFill; border: 1px solid @surfaceBorder; border-radius: 12px; }
QFrame#signalLane { background: transparent; border: none; border-top: 1px solid @surfaceBorder; border-radius: 0; }
QLabel#signalEyebrow { color: @accentLabel; font-size: 10px; letter-spacing: 2px; }
QLabel#signalRunTitle { color: @textPrimary; font-family: @headingFont; font-size: 24px; }
QLabel#signalMetricName { color: @textMuted; font-size: 10px; letter-spacing: 1px; }
QLabel#signalReading { color: @accentLabel; font-family: @headingFont; font-size: 26px; }

/* Saved chats under Playground */
QPushButton#historyNew { padding: 5px 10px; border: 1px solid transparent; background: transparent; font-family: @bodyFont; text-align: left; border-radius: 8px; color: @accentLabel; font-size: 12px; }
QPushButton#historyNew:hover { background: @surfaceFillHover; }
QPushButton#historyNew:disabled { color: @textMuted; }
QListWidget#historyList { background: transparent; border: none; outline: none; font-family: @bodyFont; font-size: 12px; }
QListWidget#historyList::item { padding: 4px 10px; border-radius: 8px; color: @textSecondary; border: 1px solid transparent; }
QListWidget#historyList::item:hover { background: @surfaceFillHover; }
QListWidget#historyList::item:selected { background: @surfaceFill; color: @textPrimary; border: 1px solid @surfaceBorder; }
QListWidget#historyList:focus { border: none; }
QLabel#historyNotice { color: @statusWarning; font-size: 11px; padding: 4px 10px; }

/* Quiet popover surfaces and full-size native keyboard targets. */
QMenu { background: @surfaceFill; color: @textPrimary; border: 1px solid @surfaceBorder; border-radius: 8px; padding: 4px; }
QMenu::item { padding: 7px 14px; margin: 1px 2px; border-radius: 5px; }
QMenu::item:selected { background: @surfaceFillHover; color: @textPrimary; }
QMenu::item:disabled { color: @textMuted; }
QMenu::separator { height: 1px; background: @surfaceBorder; margin: 4px 6px; }
QToolTip { border: 1px solid @surfaceBorder; padding: 7px 10px; }
QDialogButtonBox { spacing: 8px; }
QScrollBar::handle:horizontal:hover { background: @accentHover; }

/* Training studio: live experiment first, next-run recipe underneath. */
QFrame#trainingSignalBoard, QFrame#trainingRunContext, QFrame#trainingRecipe {
    background: @surfaceFill; border: 1px solid @surfaceBorder; border-radius: 8px;
}
QLabel#trainingConfiguration { color: @textSecondary; font-size: 12px; }
QFrame#trainingSignalBoard QLabel#signalRunTitle { font-size: 22px; }
QFrame#trainingSignalBoard QLabel#signalReading { font-size: 24px; }
QFrame#trainingSignalBoard QLabel#metricValue { color: @textSecondary; font-size: 12px; }
QFrame#trainingBudget { background: @insetBackground; border: 1px solid @surfaceBorder; border-radius: 6px; }
QLabel#signalSecondaryReading { color: @textPrimary; font-family: @headingFont; font-size: 24px; }

/* Approved web preview: training workspace hierarchy and density. */
QWidget#trainingPage QLabel { font-size: 11px; }
QWidget#trainingPage QLabel#trainingPageTitle { font-family: @headingFont; font-weight: 600; font-size: 32px; }
QWidget#trainingPage QLabel#trainingTitleMarker { font-family: @monoFont; font-size: 9px; color: @textMuted; padding-left: 17px; border-left: 1px solid @surfaceBorder; }
QWidget#trainingPage QLabel#trainingBreadcrumb { font-size: 11px; color: @textMuted; }
QWidget#trainingPage QLabel#trainingSubtitle { font-size: 12px; color: @textSecondary; }
QWidget#trainingPage QLabel#trainingCardHeading, QWidget#trainingPage QLabel#trainingRecipeTitle { font-family: @headingFont; font-size: 13px; font-weight: 500; }
QWidget#trainingPage QLabel#trainingSectionTitle { font-family: @headingFont; font-size: 16px; }
QWidget#trainingPage QLabel#trainingEyebrow { font-size: 9px; color: @textMuted; letter-spacing: 2px; }
QWidget#trainingPage QLabel#trainingRunTitle { font-family: @headingFont; font-size: 21px; }
QWidget#trainingPage QLabel#trainingMicro { font-size: 10px; color: @textMuted; }
QWidget#trainingPage QLabel#trainingTiny { font-size: 8px; color: @textMuted; font-family: @monoFont; }
QWidget#trainingPage QLabel#trainingMono { font-size: 10px; font-family: @monoFont; }
QWidget#trainingPage QLabel#trainingAccentMicro { font-size: 10px; font-family: @monoFont; color: @accentLabel; }
QWidget#trainingPage QLabel#trainingBadge { border: 1px solid @surfaceBorder; border-radius: 10px; padding: 3px 8px; font-size: 9px; color: @textSecondary; }
QWidget#trainingPage QLabel#trainingBadge[state="ok"] { color: @statusSuccess; }
QWidget#trainingPage QLabel#trainingBadge[state="error"] { color: @statusError; }
QWidget#trainingPage QLabel#trainingBadge[state="warn"] { color: @statusWarning; }
QWidget#trainingPage QFrame#trainingStat { border: none; border-left: 1px solid @surfaceBorder; }
QWidget#trainingPage QLabel#trainingStatLabel { font-size: 10px; color: @textMuted; }
QWidget#trainingPage QLabel#trainingStatAccent { font-family: @headingFont; font-size: 28px; color: @accentLabel; }
QWidget#trainingPage QLabel#trainingStatValue { font-family: @headingFont; font-size: 28px; }
QWidget#trainingPage QLabel#trainingStatNote { font-size: 9px; color: @textMuted; }
QWidget#trainingPage QLabel#trainingLegend { font-size: 10px; color: @textMuted; }
QWidget#trainingPage QLabel#trainingAxis { font-family: @monoFont; font-size: 8px; color: @textMuted; letter-spacing: 1px; qproperty-alignment: AlignCenter; }
QWidget#trainingPage QTabBar#trainingMetricTabs { font-size: 11px; }
QWidget#trainingPage ToggleSwitch#trainingSmoothing, QWidget#trainingPage ToggleSwitch { font-size: 10px; }
QWidget#trainingPage QFrame#trainingComputeCard, QWidget#trainingPage QFrame#trainingRunContext, QWidget#trainingPage QFrame#trainingActivityCard,
QWidget#trainingPage QFrame#trainingMiniCard, QWidget#trainingPage QFrame#trainingLogCard { background: @surfaceFill; border: 1px solid @surfaceBorder; border-radius: 8px; }
QWidget#trainingPage QFrame#trainingMonitorFooter, QWidget#trainingPage QFrame#trainingThermal { border: none; border-top: 1px solid @surfaceBorder; }
QWidget#trainingPage QLabel#trainingDeviceName { font-size: 12px; font-weight: 500; }
QWidget#trainingPage QLabel#trainingChip { color: @accentLabel; font-size: 28px; }
QWidget#trainingPage QFrame#trainingUtilBar { background: @insetBackground; border: none; border-radius: 1px; }
QWidget#trainingPage QFrame#trainingUtilBar[lit="true"] { background: @accentPrimary; }
QWidget#trainingPage QLabel#trainingTimeline { font-size: 10px; color: @textSecondary; }
QWidget#trainingPage QWidget#trainingExperimentIndex { border-right: 1px solid @surfaceBorder; }
QWidget#trainingPage QListWidget#trainingRuns { background: transparent; border: none; outline: none; }
QWidget#trainingPage QListWidget#trainingRuns::item { border: 1px solid transparent; border-radius: 5px; margin-bottom: 7px; }
QWidget#trainingPage QListWidget#trainingRuns::item:selected { background: @surfaceFill; border-color: @surfaceBorder; border-left: 2px solid transparent; }
QWidget#trainingPage QWidget#trainingIndexItem { border: none; background: transparent; }
QWidget#trainingPage QLabel#trainingIndexName { font-size: 11px; font-weight: 500; }
QWidget#trainingPage QLabel#trainingIndexLoss { font-family: @headingFont; font-size: 16px; }
QWidget#trainingPage QTableWidget#trainingExperimentTable { background: @surfaceFill; border: 1px solid @surfaceBorder; border-radius: 8px; outline: none; }
QWidget#trainingPage QTableWidget#trainingExperimentTable::item { border-bottom: 1px solid @surfaceBorder; padding: 9px 12px; font-size: 10px; }
QWidget#trainingPage QTableWidget#trainingExperimentTable::item:selected { background: @surfaceFillHover; color: @textPrimary; }
QWidget#trainingPage QTableWidget#trainingExperimentTable QHeaderView::section { background: @insetBackground; color: @textMuted; font-size: 8px; border: none; padding: 11px 12px; }
QWidget#trainingPage QLabel#trainingRecipeSummary { font-size: 12px; padding: 8px 0; }
QWidget#trainingPage QPushButton { font-size: 11px; }
QWidget#trainingPage QPushButton#trainingReuseRun { background: @insetBackground; font-size: 10px; }
QWidget#trainingPage QPushButton#trainingStopRun, QWidget#trainingPage QPushButton#trainingConfigureRun { font-size: 10px; padding: 3px 0; min-height: 18px; }
QWidget#trainingPage QPushButton#trainingLogToggle { padding: 10px 14px; font-size: 10px; text-align: left; }
QWidget#trainingPage QLineEdit#trainingRunSearch { font-size: 11px; padding: 8px 10px; }
QWidget#trainingPage QFrame#recipeNode { border: none; }
QWidget#trainingPage QFrame#trainingRecipe { border-radius: 8px; }
QDialog#trainingRunDialog { background: @surfaceFill; }
QDialog#trainingRunDialog QLabel { font-size: 11px; }
QDialog#trainingRunDialog QLabel#trainingRecipeTitle { font-family: @headingFont; font-size: 24px; }
QDialog#trainingRunDialog QFrame#trainingRecipe { border: none; background: @surfaceFill; }
QWidget#trainingPage QLabel#trainingComparisonSummary { font-size: 10px; padding: 9px; background: @insetBackground; color: @comparisonSeries; border-radius: 4px; }
QWidget#trainingPage[observatory="true"] QLabel#trainingStatValue, QWidget#trainingPage[observatory="true"] QLabel#trainingStatAccent { font-size: 23px; }
QWidget#trainingPage[observatory="true"] QLabel#trainingStatLabel { font-size: 9px; }
QWidget#trainingPage QPushButton[trainingHeaderAction="true"] { font-size: 13px; padding: 9px 14px; }
QWidget#trainingPage QFrame#trainingStatsFrame { border: none; border-top: 1px solid @surfaceBorder; }
QWidget#trainingPage QFrame#trainingDeviceFrame { border: none; border-bottom: 1px solid @surfaceBorder; }
QWidget#trainingPage QLabel#trainingRecipeMark { background: @insetBackground; border: 1px solid @surfaceBorder; border-radius: 5px; }
/* Shared shell proportions from the approved preview; collapse motion is unchanged. */
QWidget#sidebar { background: @canvasBackground; }
QFrame#sidebarLocalCard { background: @insetBackground; border: 1px solid @surfaceBorder; border-radius: 7px; }
QLabel#sidebarLocalName { font-size: 11px; }
QLabel#sidebarLocalDetail { font-size: 10px; color: @textMuted; }
QWidget#trainingPage QLabel#trainingStatValue[compact="true"], QWidget#trainingPage QLabel#trainingStatAccent[compact="true"] { font-size: 23px; }
QDialog#trainingRunDialog QLabel#trainingDialogTitle { font-family: @headingFont; font-size: 24px; font-weight: 500; }
QDialog#trainingRunDialog QLabel#trainingEyebrow { font-size: 9px; letter-spacing: 1px; color: @textMuted; }
QDialog#trainingRunDialog QLabel#trainingMicro { color: @textMuted; font-size: 11px; }
QDialog#trainingRunDialog QLabel#trainingDialogEstimate { background: @insetBackground; border: 1px solid @surfaceBorder; border-radius: 5px; padding: 14px; font-size: 11px; }
QDialog#trainingRunDialog QLineEdit, QDialog#trainingRunDialog QSpinBox, QDialog#trainingRunDialog QDoubleSpinBox, QDialog#trainingRunDialog QComboBox { font-size: 12px; }
QWidget#trainingPage QTableWidget#trainingExperimentTable::item:selected { background: @insetBackground; color: @textPrimary; }
QWidget#trainingPage QLabel#trainingRecipeTitle { font-family: @headingFont; font-size: 16px; font-weight: 500; }

/* Training interaction polish: visible feedback and keyboard focus. */
QWidget#trainingPage QLabel#statusLabel { padding: 10px 12px; background: @insetBackground; border: 1px solid @surfaceBorder; border-radius: 6px; }
QWidget#trainingPage QLabel#trainingEmptyState { color: @textMuted; background: @insetBackground; border: 1px dashed @surfaceBorder; border-radius: 6px; padding: 18px; font-size: 12px; }
QWidget#trainingPage QLineEdit#trainingIndexSearch { font-size: 11px; padding: 8px 9px; }
QWidget#trainingPage QListWidget#trainingRuns:focus, QWidget#trainingPage QTableWidget#trainingExperimentTable:focus { outline: 0; border: none; }
QWidget#trainingPage QPushButton#trainingRunActions, QWidget#trainingPage QPushButton#trainingFollowActive { padding: 3px 6px; min-height: 24px; font-size: 11px; }
QDialog#trainingRunDialog QScrollArea#trainingDialogScroll { border: none; background: @surfaceFill; }
QDialog#trainingRunDialog QComboBox[invalid="true"], QDialog#trainingRunDialog QLineEdit[invalid="true"] { border-color: @statusError; }
QDialog#trainingRunDialog QLabel#trainingDialogStatus { font-size: 11px; color: @textSecondary; }
QDialog#trainingRunDialog QLabel#trainingDialogStatus[state="error"] { color: @statusError; }
QDialog#trainingRunDialog QLabel#trainingDialogStatus[state="warn"] { color: @statusWarning; }
QWidget#trainingPage QFrame#trainingFeedback { background: @insetBackground; border: 1px solid @surfaceBorder; border-radius: 6px; }
QWidget#trainingPage QFrame#trainingFeedback QLabel#statusLabel { background: transparent; border: none; padding: 0; }
QWidget#trainingPage QPushButton#trainingDismissStatus { padding: 3px; min-height: 22px; }

/* Instant chart readouts are local overlays, not delayed platform tooltips. */
QLabel#trainingChartHover, QWidget#trainingPage QLabel#trainingChartHover {
    background: @chartHoverFill; color: @chartHoverText; border: 1px solid @surfaceBorder;
    border-radius: 5px; padding: 5px 7px; font-family: @monoFont; font-size: 10px;
}
QScrollBar::handle:vertical:pressed, QScrollBar::handle:horizontal:pressed { background: @accentActive; }

/* Stable status/action alignment and a readable, selectable event stream. */
QWidget#trainingPage QLabel#trainingBadge { min-height: 18px; max-height: 24px; padding: 2px 8px; border-radius: 11px; font-size: 10px; }
QWidget#trainingPage QPushButton#trainingRunActions { padding: 0; min-height: 26px; font-size: 16px; }
QWidget#trainingPage QPushButton#trainingLogToggle { padding: 5px 2px; font-family: @headingFont; font-size: 12px; }
QWidget#trainingPage QPushButton#trainingLogFollow, QWidget#trainingPage QPushButton#trainingLogCopy { padding: 4px 8px; font-size: 10px; min-height: 22px; }
QWidget#trainingPage QPlainTextEdit#trainingEventLog { font-family: @monoFont; font-size: 11px; background: @insetBackground; color: @textPrimary; border: 1px solid @surfaceBorder; border-radius: 5px; padding: 10px; }
QWidget#trainingPage QLineEdit#trainingLogSearch { font-size: 11px; padding: 6px 9px; }

/* Inner tracks reserve a little space, but their 3px handles appear only while scrolling. */
QScrollBar[innerScroll="true"]:vertical { width: 9px; margin: 0 0 0 6px; }
QScrollBar[innerScroll="true"]:horizontal { height: 9px; margin: 6px 0 0 0; }
QScrollBar[innerScroll="true"][scrollActive="false"]::handle:vertical,
QScrollBar[innerScroll="true"][scrollActive="false"]::handle:horizontal { background: transparent; }
QScrollBar[innerScroll="true"][scrollActive="true"]::handle:vertical,
QScrollBar[innerScroll="true"][scrollActive="true"]::handle:horizontal { background: @accentPrimary; }

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QTextEdit:focus, QPlainTextEdit:focus { background: @insetBackground; }
QWidget:focus { outline: 0; }
QPushButton#themeToggle:focus, QPushButton#navBtn:focus, QPushButton#navBtn:checked:focus,
QPushButton#sidebarToggle:focus, QPushButton#sidebarNewChat:focus, QPushButton#historyNew:focus { border-color: @accentLabel; }

/* Settings utility window; the workspace remains underneath. */
QDialog#settingsWindow { background: @surfaceFill; border: 1px solid @surfaceBorder; border-radius: 14px; }
QWidget#settingsPanel { background: transparent; }
QWidget#settingsContent { background: @surfaceFill; border-top-right-radius: 13px; border-bottom-right-radius: 13px; }
QWidget#settingsNavigation { background: @canvasBackground; border-right: 1px solid @surfaceBorder; border-top-left-radius: 13px; border-bottom-left-radius: 13px; }
QPushButton#settingsCategory { padding: 9px 12px; min-height: 22px; text-align: left; border: none; font-size: 12px; }
QLabel#settingsNavTitle { font-family: @headingFont; font-size: 23px; padding: 0 10px 6px 10px; }
QLabel#settingsEyebrow { color: @textMuted; font-size: 9px; letter-spacing: 2px; }
QLabel#settingsTitle { font-family: @headingFont; font-size: 28px; }
QLabel#settingsHint { color: @textMuted; font-size: 12px; }
QLabel#settingsRowTitle { font-size: 13px; font-weight: 500; }
QLabel#settingsFooter { color: @textMuted; font-size: 10px; padding: 16px 0; }
QFrame#settingsRule { background: @surfaceBorder; border: none; }
QFrame#settingsNote { background: @canvasBackground; border: 1px solid @surfaceBorder; border-radius: 8px; }
QPushButton#settingsClose { padding: 0; min-height: 0; font-size: 22px; }
QScrollArea#settingsScroll, QScrollArea#settingsScroll > QWidget, QScrollArea#settingsScroll > QWidget > QWidget { background: transparent; border: none; }
QPushButton#deleteAllChats { color: @statusError; }

QPushButton[themeChoice="true"] { min-height: 143px; max-height: 143px; min-width: 110px; padding: 0; }

/* Structured settings summaries and matching utility dialogs. */
QDialog#settingsDetailDialog { background: @surfaceFill; border: 1px solid @surfaceBorder; border-radius: 14px; }
QFrame#settingsStorageOverview { background: @canvasBackground; border: 1px solid @surfaceBorder; border-radius: 10px; }
QLabel#settingsStorageTotal { font-family: @headingFont; font-size: 29px; }
QLabel#settingsStorageFree { font-weight: 500; font-size: 12px; }
QFrame#settingsMetric { background: @canvasBackground; border: 1px solid @surfaceBorder; border-radius: 8px; }
QFrame#settingsStorageOverview QFrame#settingsMetric { background: @surfaceFill; }
QLabel#settingsMetricValue { font-family: @headingFont; font-size: 17px; }
QFrame[metricTone="models"] QLabel#settingsHint { color: @accentLabel; }
QFrame[metricTone="workspace"] QLabel#settingsHint { color: @comparisonSeries; }
QLabel#settingsRuntimeStatus { color: @textMuted; background: @canvasBackground; padding: 6px 10px; border-radius: 10px; font-size: 11px; }
QFrame#settingsPackageCard { background: @canvasBackground; border: 1px solid @surfaceBorder; border-radius: 8px; }
QLabel#settingsPackageStatus { font-size: 11px; color: @textSecondary; }
QLabel#settingsPackageStatus[packageState="installed"] { color: @statusSuccess; }
QLabel#settingsPackageStatus[packageState="installing"] { color: @accentLabel; }
QLabel#settingsPackageStatus[packageState="failed"] { color: @statusError; }
QLabel#settingsPackageNote { font-size: 11px; color: @textMuted; }
QLabel#settingsKeycap { background: @canvasBackground; border: 1px solid @surfaceBorder; border-radius: 6px; font-size: 12px; padding: 7px 12px; min-width: 120px; }

QLabel#settingsRuntimeStatus[connected="true"] { color: @statusSuccess; }

/* Compact app-owned window controls, shared with dialogs and file pickers. */
QFrame#appWindowHeader { background: @surfaceFill; border: none; border-bottom: 1px solid @surfaceBorder; }
QLabel#appWindowTitle { color: @textSecondary; font-size: 12px; }
QPushButton#windowClose, QPushButton#windowMinimize, QPushButton#windowMaximize { padding: 0; min-height: 0; font-size: 18px; }

/* Offline Docs reference workspace. */
QWidget#docsPanel, QWidget#docsPage, QScrollArea#docsScroll, QTextBrowser#docsRichText { background: transparent; border: none; }
QFrame#docsToolbar, QFrame#docsReaderTools { background: @surfaceFill; border: none; border-bottom: 1px solid @surfaceBorder; }
QWidget#docsNavigation { background: @surfaceFill; border-right: 1px solid @surfaceBorder; }
QWidget#docsContents { border-left: 1px solid @surfaceBorder; }
QLabel#docsToolbarTitle { font-family: @headingFont; font-weight: 600; font-size: 16px; }
QLineEdit#docsSearch { background: @canvasBackground; border: 1px solid @surfaceBorder; border-radius: 8px; padding: 9px 12px; font-size: 12px; }
QLineEdit#docsSearch:focus { border-color: @accentPrimary; }
QLabel#docsHero { font-family: @headingFont; font-size: 36px; font-weight: 500; color: @textPrimary; }
QLabel#docsHeading { font-family: @headingFont; font-size: 34px; font-weight: 500; color: @textPrimary; }
QLabel#docsIntro { font-size: 14px; color: @textSecondary; line-height: 160%; }
QLabel#docsSectionTitle { font-family: @headingFont; font-size: 21px; font-weight: 500; color: @textPrimary; }
QLabel#docsCardTitle { font-family: @headingFont; font-size: 16px; font-weight: 500; color: @textPrimary; }
QLabel#docsSmallTitle { font-size: 12px; font-weight: 500; color: @textPrimary; }
QLabel#docsBody { font-size: 14px; color: @textSecondary; }
QLabel#docsCardDescription { font-size: 12px; color: @textSecondary; }
QLabel#docsHint { font-size: 11px; color: @textMuted; }
QLabel#docsEyebrow { font-size: 10px; font-weight: 600; color: @textMuted; letter-spacing: 1px; }
QLabel#docsOffline { font-size: 10px; color: @accentLabel; }
QLabel#docsQuestion { font-size: 13px; color: @textPrimary; }
QFrame#docsFeature, QFrame#docsInlineContents, QFrame#docsExample { background: @surfaceFill; border: 1px solid @surfaceBorder; border-radius: 10px; }
QFrame#docsCallout { background: @surfaceFill; border: none; border-left: 3px solid @accentPrimary; border-radius: 6px; }
QFrame#docsRule { background: @surfaceBorder; border: none; }
QLabel#docsStatus { background: @surfaceFill; padding: 10px 22px; border-top: 1px solid @surfaceBorder; color: @textSecondary; font-size: 12px; }
QPushButton#docsNav, QPushButton#docsArticleNav, QPushButton#docsSubject, QPushButton#docsSectionLink { padding: 7px 10px; min-height: 16px; font-size: 12px; }
QPushButton#docsArticleNav { padding-left: 20px; font-size: 11px; }
QPushButton#docsSubject { font-weight: 600; font-size: 11px; }
QPushButton#docsNav:checked, QPushButton#docsArticleNav:checked, QPushButton#docsSectionLink:checked { color: @accentLabel; }
QPushButton#docsSources { padding: 8px 0; font-size: 11px; }
QPushButton#docsTextButton, QPushButton#docsRecent { padding: 5px 10px; min-height: 18px; font-size: 12px; }
QPushButton#docsSectionLink { padding: 8px 6px; font-size: 11px; }
QPushButton#docsPermalink { min-width: 16px; padding: 4px 6px; color: @textMuted; }
QPushButton#docsBookmark { padding: 5px 10px; font-size: 11px; }
QPushButton#docsExampleTab { padding: 6px 9px; font-size: 11px; }
QPushButton#docsCopyExample, QPushButton#docsWrapExample, QPushButton#docsDownloadExample { padding: 6px 9px; font-size: 11px; }
QPlainTextEdit#docsExampleCode { background: @canvasBackground; color: @textPrimary; border: none; border-radius: 6px; padding: 12px; font-family: @monoFont; font-size: 12px; }

QWidget#docsPanel { background: @canvasBackground; }
QLabel#docsFeatureTitle { font-family: @headingFont; font-size: 27px; font-weight: 500; color: @textPrimary; }
QPushButton#docsHistoryBack, QPushButton#docsHistoryForward, QPushButton#docsMenu { padding: 0; min-width: 0; min-height: 28px; }
QFrame#docsQuestions { border: none; border-left: 1px solid @surfaceBorder; }


/* Native desktop model discovery. */
QLabel#hubPageTitle { font-family: @headingFont; font-size: 30px; font-weight: 600; color: @textPrimary; }
QLabel#hubCardTitle { font-family: @headingFont; font-size: 18px; font-weight: 600; color: @textPrimary; }
QLabel#hubSectionTitle { font-family: @headingFont; font-size: 17px; font-weight: 600; color: @textPrimary; }
QLabel#hubStatValue { font-family: @headingFont; font-size: 21px; color: @textPrimary; }
QLabel#hubMeta { font-size: 12px; color: @textSecondary; }
QLabel#hubSmallMeta { font-size: 11px; color: @textMuted; }
QLabel#hubValue { font-size: 13px; color: @textPrimary; }
QLabel#hubLocalState { font-size: 11px; color: @statusSuccess; }
QLabel#hubTag { background: @canvasBackground; padding: 4px 7px; border-radius: 4px; font-size: 11px; color: @textSecondary; }
QLabel#hubCallout { background: @insetBackground; border-left: 2px solid @accentPrimary; padding: 12px; color: @textSecondary; }
QFrame#hubModelCard, QFrame#hubFilters, QFrame#hubDownloadStrip, QFrame#hubCompareTray { background: @surfaceFill; border: 1px solid @surfaceBorder; border-radius: 10px; }
QPushButton#hubFiltersToggle:checked { background: @surfaceFillActive; color: @accentLabel; }
QPushButton#hubViewDetails { background: transparent; border: none; color: @textPrimary; padding: 6px 8px; }
QPushButton#hubViewDetails:hover { background: @surfaceFillHover; }

QWidget#modelHubPanel QCheckBox::indicator {
    width: 13px; height: 13px;
    border: 1px solid @surfaceBorder;
    border-radius: 3px;
    background: @canvasBackground;
}
QWidget#modelHubPanel QCheckBox:focus::indicator { border-color: @accentLabel; }
QWidget#modelHubPanel QCheckBox:focus { color: @accentLabel; }
QWidget#modelHubPanel QCheckBox::indicator:checked {
    background: @accentPrimary;
    border-color: @accentPrimary;
    image: url(:/icons/check.svg);
}

/* Model Hub reference layout: native desktop cards, model page and utility dialogs. */
QFrame#hubDeviceCard, QFrame#hubSurface, QFrame#hubStats {
    background: @surfaceFill; border: 1px solid @surfaceBorder; border-radius: 10px;
}
QLabel#hubDeviceTitle { font-size: 12px; font-weight: 500; color: @textPrimary; }
QLabel#hubPublisherAvatar { background: @canvasBackground; color: @textPrimary; border-radius: 5px; font-family: @headingFont; font-size: 13px; font-weight: 600; }
QLabel#hubPublisher { font-size: 11px; color: @textSecondary; }
QPushButton#hubModelName, QPushButton#hubComparisonModelName {
    font-family: @headingFont; font-size: 18px; font-weight: 600;
    padding: 0; min-height: 0; border: none; background: transparent; text-align: left;
}
QPushButton#hubComparisonModelName { font-size: 16px; }
QPushButton#hubViewDetails, QPushButton#hubTextLink, QPushButton#hubDeviceDetails {
    border: none; background: transparent; font-size: 11px; min-height: 20px; padding: 3px 4px;
}
QLabel#hubCardDescription { font-size: 12px; color: @textSecondary; }
QLabel#hubPill { background: @canvasBackground; color: @textSecondary; padding: 3px 6px; border-radius: 3px; font-size: 10px; }
QLabel#hubLocalPill { background: @insetBackground; color: @statusSuccess; padding: 3px 6px; border-radius: 3px; font-size: 10px; }
QLabel#hubCardValue { font-size: 13px; font-weight: 500; color: @textPrimary; }
QFrame#hubRule { background: @surfaceBorder; border: none; }
QLabel#hubDetailTitle { font-family: @headingFont; font-size: 32px; font-weight: 600; color: @textPrimary; }
QFrame#hubStatCell { background: transparent; border: none; border-left: 1px solid @surfaceBorder; }
QFrame#hubStatCell[first="true"] { border-left: none; }
QLabel#hubBody { color: @textSecondary; font-size: 13px; }
QLabel#hubSmallTitle { color: @textPrimary; font-size: 12px; font-weight: 500; }
QFrame#hubUseCase { background: @canvasBackground; border: none; border-radius: 6px; }
QLabel#hubCallout { background: @accentSurface; border: none; border-left: 2px solid @accentPrimary; border-radius: 0; padding: 12px 14px; font-size: 12px; color: @textSecondary; }
QFrame#hubSpecRow { background: transparent; border: none; border-bottom: 1px solid @surfaceBorder; }
QLabel#hubMemoryEstimate { font-family: @headingFont; font-size: 23px; color: @textPrimary; }
QLabel#hubEstimateStatus { font-size: 11px; font-weight: 500; color: @textMuted; }
QLabel#hubEstimateStatus[state="ok"] { color: @statusSuccess; }
QLabel#hubEstimateStatus[warning="true"] { color: @statusWarning; }
QLabel#hubWeightKey { font-size: 10px; color: @accentLabel; }
QLabel#hubCacheKey { font-size: 10px; color: @comparisonSeries; }
QPushButton#hubDownloadModel { background: @accentPrimary; color: @accentText; border-color: @accentPrimary; padding: 9px 10px; }
QDialog#hubCompareDialog, QDialog#hubDeviceDialog, QDialog#hubDownloadDialog { background: transparent; }
QLabel#hubDialogTitle { font-family: @headingFont; font-size: 24px; font-weight: 600; color: @textPrimary; }
QFrame#hubComparisonCell { background: transparent; border: none; border-bottom: 1px solid @surfaceBorder; }
QFrame#hubComparisonHeader { background: transparent; border: none; border-bottom: 1px solid @surfaceBorder; }
QDialog#hubCompareDialog QScrollArea, QDialog#hubDeviceDialog QScrollArea { background: transparent; border: none; }
QTableWidget#hubFileTable, QTableWidget#hubEvaluationTable { background: @surfaceFill; color: @textPrimary; border: none; selection-background-color: @surfaceFillHover; }
QTableWidget#hubFileTable::item, QTableWidget#hubEvaluationTable::item { border-bottom: 1px solid @surfaceBorder; padding: 10px 8px; }
QTableWidget#hubFileTable QHeaderView::section, QTableWidget#hubEvaluationTable QHeaderView::section { background: @surfaceFill; color: @textMuted; font-size: 11px; border: none; border-bottom: 1px solid @surfaceBorder; padding: 10px 8px; }

/* Keep shortlist selection visible while browsing. */
QFrame#hubModelCard[selected="true"] { border-color: @accentPrimary; }

QPushButton#hubCardCompare { font-size: 11px; padding: 3px 8px; min-height: 0; }

QPushButton#hubDialogClose { padding: 0; min-height: 0; min-width: 0; border: none; }

/* Library inventory and collection lists share one rounded surface. */
QWidget#libraryListSurface { background: @surfaceFill; border: 1px solid @surfaceBorder; border-radius: 10px; }
QFrame#modelCard[libraryRow="true"], QFrame#adapterCard[libraryRow="true"], QFrame#libraryListRow {
    background: transparent;
    border: none;
    border-bottom: 1px solid @surfaceBorder;
    border-radius: 0;
}
QFrame#modelCard[libraryRow="true"][selected="true"], QFrame#adapterCard[libraryRow="true"][active="true"] {
    background: @surfaceFillHover;
}
QFrame#modelCard[libraryRow="true"][lastRow="true"], QFrame#adapterCard[libraryRow="true"][lastRow="true"], QFrame#libraryListRow[lastRow="true"] {
    border-bottom: none;
}

QFrame#conversationKnowledge {
    background: @surfaceFill;
    border: 1px solid @surfaceBorder;
    border-radius: 10px;
}
QPushButton#historyNew[conversationAction="true"] {
    background: @accentSurface;
    color: @accentLabel;
}
QPushButton#historyNew[conversationAction="true"]:hover {
    background: @surfaceFillHover;
}
QPushButton#historyNew[conversationAction="true"]:pressed {
    background: @surfaceFillActive;
}
QPushButton#historyNew[conversationAction="true"]:disabled {
    background: @insetBackground;
    color: @textMuted;
}

QPushButton#conversationSearchToggle {
    padding: 0;
    min-height: 0;
    min-width: 0;
    border: 1px solid transparent;
    background: transparent;
}
QPushButton#conversationSearchToggle:hover, QPushButton#conversationSearchToggle:checked {
    background: @surfaceFillHover;
    border-color: @surfaceBorder;
}
QMenu#conversationOptions::item {
    padding-left: 30px;
    min-width: 92px;
}
