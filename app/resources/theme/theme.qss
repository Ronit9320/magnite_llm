/*
 * Magnite — global stylesheet (design doc §2–§5).
 *
 * This is the structured master sheet: every color/font token below is spelled
 * as a leading-at-sign placeholder (e.g. "@bgVoid") and injected at runtime by
 * Theme::qss() from theme.h, so the palette lives in exactly one place. Do not
 * hardcode hex values here, and do not write stray at-signs even in comments —
 * a surviving token is detected by Theme::selfCheck().
 *
 * Object names used by panels:
 *   QPushButton  #primaryBtn / #secondaryBtn / #destructiveBtn
 *   QLabel       #panelTitle, #panelSubtitle, #headingLabel, #bodyLabel,
 *                #mutedLabel, #monoLabel, #statusLabel, #statusPill
 */

/* ---------- Buttons (design doc §5) ---------- */

QPushButton {
    background: @glassFill;
    border: 1px solid @glassBorder;
    border-radius: 8px;
    color: @textPrimary;
    font-family: "@bodyFont";
    font-size: 13px;
    padding: 7px 16px;
}
QPushButton:hover {
    background: @glassFillHover;
    border-color: @glassBorderHover;
}
QPushButton:pressed {
    background: @glassFillActive;
}
QPushButton:disabled {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid @glassBorder;
    color: @textMuted;
}
QPushButton:focus {
    border-color: @glassBorderActive;
}

QPushButton#primaryBtn {
    background-color: @accentPrimary;
    border: 1px solid rgba(59, 130, 246, 0.55);
    color: #FFFFFF;
    font-weight: 500;
}
QPushButton#primaryBtn:hover {
    background: #60A5FA;
    border-color: #60A5FA;
}
QPushButton#primaryBtn:pressed {
    background: #2563EB;
}
QPushButton#primaryBtn:disabled {
    background: rgba(59, 130, 246, 0.35);
    border: 1px solid rgba(59, 130, 246, 0.25);
    color: rgba(245, 245, 247, 0.5);
}

QPushButton#secondaryBtn {
    background: @glassFill;
    border: 1px solid @glassBorder;
    color: @textPrimary;
}
QPushButton#secondaryBtn:hover {
    background: @glassFillHover;
    border-color: @glassBorderHover;
}
QPushButton#secondaryBtn:disabled {
    background: rgba(255, 255, 255, 0.02);
    color: @textMuted;
}

QPushButton#destructiveBtn {
    background-color: @statusError;
    border: 1px solid rgba(248, 113, 113, 0.55);
    color: #1B0A0A;
    font-weight: 500;
}
QPushButton#destructiveBtn:hover {
    background: #FCA5A5;
}
QPushButton#destructiveBtn:disabled {
    background: rgba(248, 113, 113, 0.35);
    border: 1px solid rgba(248, 113, 113, 0.25);
    color: rgba(27, 10, 10, 0.5);
}

/* ---------- Inputs (design doc §5) ---------- */

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QTextEdit,
QPlainTextEdit {
    background: @glassFill;
    border: 1px solid @glassBorder;
    border-radius: 8px;
    color: @textPrimary;
    font-family: "@bodyFont";
    font-size: 13px;
    padding: 6px 10px;
    selection-background-color: @accentPrimary;
    selection-color: #FFFFFF;
}
QPlainTextEdit {
    /* Multi-line sinks (: conversation, log) read as glass cards too. */
    selection-background-color: @accentPrimary;
    selection-color: #FFFFFF;
}
QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: @glassBorderHover;
}
QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid @glassBorderActive;
    background: @glassFillActive;
}
QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    color: @textMuted;
}

QLineEdit::placeholder,
QTextEdit::placeholder,
QPlainTextEdit::placeholder {
    color: @textMuted;
}

/* Training log + metric buffers: mono, secondary (design doc §3). */
QPlainTextEdit#logView {
    font-family: "@monoFont";
    font-size: 13px;
    color: @textSecondary;
}

/* Spin-box arrows: keep the default glyphs, just quiet the background. */
QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    background: transparent;
    border: none;
    width: 18px;
}

/* Combo popup list hosts a real popup window; give it a dark glass card. */
QComboBox QAbstractItemView {
    background: @bgDeep;
    border: 1px solid @glassBorder;
    border-radius: 8px;
    color: @textPrimary;
    selection-background-color: @accentPrimary;
    selection-color: #FFFFFF;
    padding: 4px;
    outline: none;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    image: none;
}

/* ---------- Checkboxes (design doc §5) ---------- */

QCheckBox {
    color: @textPrimary;
    font-family: "@bodyFont";
    font-size: 13px;
    background: transparent;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid @glassBorder;
    border-radius: 4px;
    background: @glassFill;
}
QCheckBox::indicator:hover {
    border-color: @glassBorderHover;
}
QCheckBox::indicator:checked {
    background: @accentPrimary;
    border: 1px solid @accentPrimary;
    image: url(:/icons/check-white.svg);
}
QCheckBox:disabled {
    color: @textMuted;
}

/* ---------- Group boxes → glass cards (design doc §4/§5) ---------- */

QGroupBox {
    background: @glassFill;
    border: 1px solid @glassBorder;
    border-radius: 12px;
    color: @textSecondary;
    font-family: "@bodyFont";
    font-size: 12px;
    font-weight: 500;
    margin-top: 14px;
    padding: 12px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
    color: @textSecondary;
}

/* ---------- Model cards (design doc §8 card grid) ---------- */

QScrollArea#cardScroll {
    background: transparent;
    border: none;
}
/* The viewport and its content host are unstyled QWidgets and would paint the
 * default light palette; transparent lets the flat-black app root show through. */
QScrollArea#cardScroll > QWidget > QWidget {
    background: transparent;
}

QFrame#modelCard {
    background: @glassFill;
    border: 1px solid @glassBorder;
    border-radius: 12px;
}
QFrame#modelCard:hover {
    border-color: @glassBorderHover;
}
QFrame#modelCard[selected="true"] {
    border: 1px solid @glassBorderActive;
}

QLabel#cardTitle {
    color: @textPrimary;
    font-family: "@headingFont";
    font-size: 15px;
    font-weight: 600;
}
QLabel#cardMeta {
    color: @textSecondary;
    font-family: "@bodyFont";
    font-size: 12px;
}
QLabel#archBadge {
    background: @glassFillHover;
    border: 1px solid rgba(59, 130, 246, 0.4);
    border-radius: 100px;
    color: @accentPrimary;
    font-family: "@bodyFont";
    font-size: 11px;
    padding: 2px 8px;
}

QProgressBar#cardProgress {
    background: @glassFill;
    border: none;
    border-radius: 2px;
    max-height: 4px;
    min-height: 4px;
}
QProgressBar#cardProgress::chunk {
    border-radius: 2px;
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                stop: 0 rgba(96, 165, 250, 1),
                                stop: 1 @accentPrimary);
}

/* ---------- Adapter cards (design doc §8) ---------- */

QFrame#adapterCard {
    background: @glassFill;
    border: 1px solid @glassBorder;
    border-radius: 12px;
}
QFrame#adapterCard:hover {
    border-color: @glassBorderHover;
}
QFrame#adapterCard[active="true"] {
    background: rgba(59, 130, 246, 0.12);
    border: 1px solid @glassBorderActive;
}

/* Method pill (LoRA/QLoRA) — same language as the arch badge but neutral. */
QLabel#adapterPill {
    background: @glassFillHover;
    border: 1px solid rgba(59, 130, 246, 0.4);
    border-radius: 100px;
    color: @accentPrimary;
    font-family: "@bodyFont";
    font-size: 11px;
    padding: 2px 8px;
}

/* Compact card footer buttons (design doc §8). */
QPushButton#cardPrimary {
    background-color: @accentPrimary;
    border: 1px solid rgba(59, 130, 246, 0.55);
    color: #FFFFFF;
    font-family: "@bodyFont";
    font-size: 12px;
    font-weight: 500;
    padding: 4px 10px;
}
QPushButton#cardPrimary:hover {
    background: #60A5FA;
    border-color: #60A5FA;
}
QPushButton#cardPrimary:pressed {
    background: #2563EB;
}
QPushButton#cardBtn {
    background: @glassFill;
    border: 1px solid @glassBorder;
    color: @textPrimary;
    font-family: "@bodyFont";
    font-size: 12px;
    padding: 4px 10px;
}
QPushButton#cardBtn:hover {
    background: @glassFillHover;
    border-color: @glassBorderHover;
}
QPushButton#cardDanger {
    background-color: @statusError;
    border: 1px solid rgba(248, 113, 113, 0.55);
    color: #1B0A0A;
    font-family: "@bodyFont";
    font-size: 12px;
    font-weight: 500;
    padding: 4px 10px;
}
QPushButton#cardDanger:hover {
    background: #FCA5A5;
}

/* ---------- RAG cards (design doc §8) ---------- */

QFrame#ragDocCard {
    background: @glassFill;
    border: 1px solid @glassBorder;
    border-radius: 12px;
}
QFrame#ragDocCard:hover {
    border-color: @glassBorderHover;
}
QFrame#ragDocCard[selected="true"] {
    background: rgba(59, 130, 246, 0.08);
    border: 1px solid @glassBorderActive;
}

/* Retrieval config card (chunk size/overlap/top-K). */
QFrame#ragConfigCard {
    background: @glassFill;
    border: 1px solid @glassBorder;
    border-radius: 12px;
}

/* ---------- Chat bubbles (specifics: comprehensive) ---------- */

/* User message: right-aligned, glass-hover fill, primary text (design doc §5). */
QFrame#chatBubbleUser {
    background: @glassFillHover;
    color: @textPrimary;
    border: 1px solid @glassBorder;
    border-radius: 12px;
}

/* Model response: left-aligned, glass fill, 2px accent left border. */
QFrame#chatBubbleAssistant {
    background: @glassFill;
    color: @textPrimary;
    border: 1px solid @glassBorder;
    border-left: 2px solid @accentPrimary;
    border-radius: 12px;
}

/* Bubble label: QSS `color` on the frame does not cascade into child widgets,
   so the text color has to be set on the label itself (design doc §5.5.6). */
QLabel#chatBubbleText {
    color: @textPrimary;
    background: transparent;
}

QLabel#chatPill {
    background: @glassFill;
    border: 1px solid @glassBorder;
    border-radius: 100px;
    padding: 4px 10px;
    color: @textSecondary;
    font-size: 12px;
}

/* ---------- Tables & lists (models/adapters grids, RAG doc list) ---------- */

QTableWidget {
    background: @glassFill;
    border: 1px solid @glassBorder;
    border-radius: 8px;
    color: @textSecondary;
    font-family: "@monoFont";
    font-size: 13px;
    gridline-color: rgba(255, 255, 255, 0.04);
    selection-background-color: @glassFillActive;
    selection-color: @textPrimary;
}
QTableWidget::item {
    padding: 4px 8px;
}
QTableWidget::item:selected {
    background: @glassFillActive;
    color: @textPrimary;
}
QTableWidget::item:hover {
    background: @glassFillHover;
}
QHeaderView::section {
    background: @glassFill;
    color: @textSecondary;
    font-family: "@bodyFont";
    font-size: 12px;
    font-weight: 500;
    border: none;
    border-bottom: 1px solid @glassBorder;
    padding: 6px 8px;
}
QTableCornerButton::section {
    background: @glassFill;
    border: none;
}

QListWidget {
    background: @glassFill;
    border: 1px solid @glassBorder;
    border-radius: 8px;
    color: @textPrimary;
    font-family: "@bodyFont";
    font-size: 13px;
    outline: none;
    padding: 4px;
}
QListWidget::item {
    padding: 4px 8px;
    border-radius: 6px;
}
QListWidget::item:selected {
    background: @glassFillActive;
    color: @textPrimary;
}
QListWidget::item:hover {
    background: @glassFillHover;
}

/* ---------- Sliders (design doc §5: blue fill, glowing thumb) ---------- */

QSlider::groove:horizontal {
    background: @glassFill;
    border: 1px solid @glassBorder;
    border-radius: 2px;
    height: 4px;
    margin: 5px 0;
}
QSlider::groove:vertical {
    background: @glassFill;
    border: 1px solid @glassBorder;
    border-radius: 2px;
    width: 4px;
    margin: 0 5px;
}
QSlider::sub-page:horizontal {
    background: @accentPrimary;
    border-radius: 2px;
}
QSlider::add-page:horizontal {
    background: @glassFill;
    border-radius: 2px;
}
QSlider::sub-page:vertical {
    background: @accentPrimary;
    border-radius: 2px;
}
QSlider::add-page:vertical {
    background: @glassFill;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #FFFFFF;
    border: 2px solid @accentPrimary;
    border-radius: 7px;
    width: 14px;
    height: 14px;
    margin: -7px 0;
}
QSlider::handle:vertical {
    background: #FFFFFF;
    border: 2px solid @accentPrimary;
    border-radius: 7px;
    width: 14px;
    height: 14px;
    margin: 0 -7px;
}
QSlider::handle:horizontal:hover,
QSlider::handle:vertical:hover {
    background: #DDD6FE;
}

/* ---------- Scrollbars (design doc §7: thin, dark) ---------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.09);
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.14);
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.09);
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 0.14);
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ---------- Labels (design doc §3 classes) ---------- */

QLabel {
    color: @textSecondary;
    font-family: "@bodyFont";
    font-size: 14px;
    background: transparent;
}
QLabel#panelTitle {
    color: @textPrimary;
    font-family: "@headingFont";
    font-size: 28px;
    font-weight: 600;
}
QLabel#panelSubtitle {
    color: @textSecondary;
    font-family: "@bodyFont";
    font-size: 12px;
}
QLabel#headingLabel {
    color: @textPrimary;
    font-family: "@headingFont";
    font-size: 20px;
    font-weight: 600;
}
QLabel#bodyLabel {
    color: @textPrimary;
}
QLabel#mutedLabel {
    color: @textMuted;
}
QLabel#monoLabel {
    color: @textSecondary;
    font-family: "@monoFont";
    font-size: 13px;
}
QLabel#statusLabel {
    color: @textMuted;
    font-family: "@monoFont";
    font-size: 12px;
}
QLabel#statusLabel[state="ok"] {
    color: @statusSuccess;
}
QLabel#statusLabel[state="error"] {
    color: @statusError;
}
QLabel#statusLabel[state="warn"] {
    color: @statusWarning;
}

/* Status pill (design doc §5): full-radius, glass fill, colored border. */
QFrame#statusPill {
    background: @glassFill;
    border: 1px solid rgba(161, 161, 170, 0.4);
    border-radius: 100px;
    color: @textSecondary;
    font-family: "@bodyFont";
    font-size: 12px;
    padding: 2px 12px;
}
QFrame#statusPill[state="ok"] {
    border: 1px solid rgba(52, 211, 153, 0.4);
    color: @statusSuccess;
}
QFrame#statusPill[state="err"] {
    border: 1px solid rgba(248, 113, 113, 0.4);
    color: @statusError;
}
QFrame#statusPill[state="warn"] {
    border: 1px solid rgba(251, 191, 36, 0.4);
    color: @statusWarning;
}

/* ---------- App shell (design doc §5 sidebar + §2 background) ---------- */

QStackedWidget {
    background: transparent;
}

/* App root: flat black base behind the glass panels (design doc §2 bg-void). */
#appRoot {
    background: @bgVoid;
}

#sidebar {
    background: @glassFill;
    border-right: 1px solid @glassBorder;
}

#logoLabel {
    color: @textPrimary;
    font-family: "@headingFont";
    font-size: 20px;
    font-weight: 600;
    padding: 12px 12px 20px 12px;
}

QPushButton#navBtn {
    background: transparent;
    border: none;
    border-left: 2px solid transparent;
    border-radius: 8px;
    color: @textSecondary;
    font-family: "@bodyFont";
    font-size: 14px;
    padding: 9px 12px;
    text-align: left;
}
QPushButton#navBtn:hover {
    background: @glassFillHover;
    color: @textPrimary;
}
QPushButton#navBtn:checked {
    background: @glassFillActive;
    border-left: 2px solid @accentPrimary;
    color: @textPrimary;
    font-weight: 500;
}

/* ---------- Dialogs & tooltips ---------- */

QDialog {
    background: @bgDeep;
}
QToolTip {
    background: @bgDeep;
    border: 1px solid @glassBorder;
    border-radius: 6px;
    color: @textPrimary;
    font-family: "@bodyFont";
    font-size: 12px;
    padding: 4px 8px;
}

/* ---------- Status bar ---------- */

QStatusBar {
    background: @bgVoid;
    border-top: 1px solid @glassBorder;
    color: @textSecondary;
    font-family: "@bodyFont";
    font-size: 12px;
}
QStatusBar::item {
    border: none;
}
